! =============================================
! Intended Config - Cisco IOS
! Host: {{ hostname }}
! Site: {{ site }}
! Generated by Ansible intended-config pipeline
! =============================================

hostname {{ hostname | default(inventory_hostname) }}

!
! DNS
{% for dns in dns_servers %}
ip name-server {{ dns }}
{% endfor %}

!
! NTP
{% for ntp in ntp_servers %}
ntp server {{ ntp }}
{% endfor %}

!
! AAA / TACACS+
aaa new-model

{% if tacacs_servers is defined %}
aaa group server tacacs+ {{ aaa_group_name }}
{% for s in tacacs_servers %}
 server name {{ s.name }}
{% endfor %}
{% endif %}

{% if aaa_source_interface is defined %}
ip tacacs source-interface {{ aaa_source_interface }}
{% endif %}

{% if tacacs_servers is defined %}
{% for s in tacacs_servers %}
tacacs server {{ s.name }}
 address ipv4 {{ s.ip }}
 key {{ tacacs_key }}
{% endfor %}
{% endif %}

aaa authentication login default group {{ aaa_group_name }} local
aaa authorization exec default group {{ aaa_group_name }} local
aaa accounting exec default start-stop group {{ aaa_group_name }}

!
! (Optional) Allow local login as fallback
username breakglass privilege 15 secret 0 CHANGE_ME

!
! SYSLOG
{% for s in syslog_servers %}
logging host {{ s }}
{% endfor %}

!
! Management (comment-only example)
! mgmt_ip={{ mgmt_ip }}

!
! Interfaces
{% for intf in interfaces %}
interface {{ intf.name }}
{% if intf.desc is defined %}
 description {{ intf.desc }}
{% endif %}
{% set mask = (intf.mask | string) %}
{% if mask.startswith('/') %}
 ip address {{ intf.ip }} {{ prefix_to_netmask[mask[1:]] }}
{% else %}
 ip address {{ intf.ip }} {{ mask }}
{% endif %}
 no shutdown
!
{% endfor %}

end
